#!/usr/bin/env python3
"""Launcher. The CLI lives in dictator.cli so the shipped app can carry it as
a compiled module instead of readable source; this stub stays plain because it
reveals nothing. In a repo install it puts the checkout on the path so the
package imports; in the bundle the app already sets PYTHONPATH."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from dictator.cli import main

sys.exit(main(sys.argv))
