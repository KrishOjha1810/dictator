#!/usr/bin/env python3
"""Dictator: hold a key anywhere on your Mac and speak. The words land where
your cursor is.

There is no per-application integration because there is nothing to integrate
with. It pastes the way you would have typed, so it works in the terminal, in
a browser, in Slack, in a text field that was written before any of this
existed.
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from dictator import core

KEYS = ("fn", "rightcmd", "rightopt", "leftcmd")

USAGE = """dictator: hold a key and talk, anywhere on your Mac.

  dictator on [fn|rightcmd|rightopt|leftcmd]
                      start now, and after every restart
  dictator off        stop, and do not start again
  dictator status     is it set up, and is it running
  dictator doctor     check everything and say what is wrong
  dictator permissions  say why macOS is not trusting it, and walk you out
  dictator permissions --explain   say it and stop, without changing anything
  dictator permissions --reset     remove the stale entry and ask again
  dictator delivery [type|clipboard]   how the words get in
  dictator capture on|off        keep recordings, to compare speech models
  dictator log        the last thing it did
  dictator errors     failures it noticed
  dictator dictate    run it in the foreground (for debugging)
  dictator build      compile the helpers and the app without starting anything

Teaching it your words:
  dictator learn WORD    fix this word when it mishears it
  dictator words         what it has learned
  dictator review        it asks you about the words it got wrong
  dictator unlearn WORD  stop fixing it
  dictator history [n]   what you have said
  dictator find WORDS    search everything you have ever dictated
  dictator recap [today|week|N]   what you worked on, summarised locally
  dictator forget "words"  erase everything you said containing them
  dictator forget all      erase the whole history

Phrases you say often:
  dictator snippet "my work email" "krish@example.com"
                         say the phrase, get the text
  dictator snippets      what expands into what
  dictator unsnippet "my work email"

Language:
  dictator language              which language it expects
  dictator language hinglish     skip the English engine entirely
  dictator language english      the default, with automatic fallback

Formatting:
  dictator format                  what is on
  dictator format lists on|off     spoken lists become real lists
  dictator format punctuation on|off
  dictator format off              paste exactly what was said
  dictator format in Slack         what is on in one application
  dictator format in Slack lists on      change it there and nowhere else
  dictator format in terminal sentences off
  dictator format in Slack default       back to the global rules
"""


def _key_from(args, default="fn"):
    for a in args:
        if a in KEYS:
            return a
    return default


def _watching(limit: int = 200) -> None:
    """Say how often it gets to see what became of a dictation.

    It can only learn from a correction it witnessed, so a low number here
    explains a vocabulary that never grows, and no other command reports it.
    """
    from dictator import history
    counts = history.watching(limit)
    counts.pop("unrecorded", None)      # rows from before this was measured
    total = sum(counts.values())
    if not total:
        print("\n  no dictations yet where it went back to look.")
        return
    looked = total - counts.get("unreadable", 0) - counts.get("moved", 0)
    print(f"\n  it saw what became of {looked} of your last {total} "
          f"dictations.")
    for key, label in history.SAW.items():
        n = counts.get(key, 0)
        if n:
            print(f"    {n:4d}  {label}")
    if not counts.get("edited"):
        print("    it has not caught a correction yet, so it has learned "
              "nothing from your edits.")


def main(argv) -> int:
    cmd = argv[1] if len(argv) > 1 else "status"
    rest = argv[2:]

    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0

    if cmd == "on":
        from dictator import always
        print(always.on(_key_from(rest)))
        return 0

    if cmd == "off":
        from dictator import always
        print(always.off())
        return 0

    if cmd == "status":
        from dictator import always
        print(always.status())
        return 0

    if cmd == "build":
        from dictator import always
        # Everything, not just the app. Building the helpers lazily put a
        # swiftc run in the middle of the first holds, which is where a new
        # user decides whether this works at all.
        built = always.build_all(force="--force" in rest)
        for name, path in built.items():
            print(f"  {'ok ' if path else 'BAD'}  {name}"
                  + (f"  {path}" if path else ""))
        if not built.get("app"):
            print("could not build the app (needs Xcode command line tools)")
        return 0 if built.get("app") else 1

    if cmd == "dictate":
        from dictator import dictate
        return dictate.run(_key_from(rest), send="--send" in rest,
                           debug="--quiet" not in rest)

    if cmd == "log":
        p = core.STATE_DIR / "dictate.log"
        if not p.exists():
            print("nothing yet. Turn it on with: dictator on")
            return 0
        n = 40
        for a in rest:
            if a.isdigit():
                n = int(a)
        print("".join(p.read_text().splitlines(keepends=True)[-n:]), end="")
        return 0

    if cmd == "errors":
        rows = core.errors()
        if not rows:
            print("no failures recorded.")
            return 0
        import time as _t
        for r in rows:
            when = _t.strftime("%H:%M:%S", _t.localtime(r.get("at", 0)))
            print(f"{when}  [{r.get('where','?')}] {r.get('msg','')} "
                  f"{r.get('hint','')}".rstrip())
        return 0

    if cmd == "learn":
        term = " ".join(rest).strip()
        if not term:
            print('usage: dictator learn "Whisper Flow"')
            return 2
        from dictator import vocab
        rec = vocab.shared().add(term)
        if rec.get("mode") == "fuzzy":
            print(f'learned "{term}". I will fix things that sound like it.')
        else:
            print(f'learned "{term}", but {rec.get("why","")}.')
        return 0

    if cmd == "review":
        from dictator import review as _review
        n = int(rest[0]) if rest and rest[0].isdigit() else 300
        rows = _review.words(n)
        if not rows:
            print("nothing to ask about. Every word it heard was a word.")
            return 0
        print(f"{len(rows)} words it is not sure it got right, the ones you")
        print("say most often first. Type what you actually said, press Return")
        print("to skip, or q to stop.\n")
        asked = taught = 0
        for r in rows:
            asked += 1
            times = f", {r['count']} times" if r["count"] > 1 else ""
            where = f" in {r['app']}" if r["app"] else ""
            print(f'  it heard "{r["word"]}"{where}{times}')
            print(f"    {_review.show(r['text'], r['word'])}")
            try:
                said = input("    what did you say? ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                said = "q"
            if said.lower() == "q":
                break
            if not said:
                print()
                continue
            rec = _review.teach(said, heard=r["word"])
            if rec.get("ok") is False:
                print(f"    not learned: {rec.get('why', '')}\n")
            elif rec.get("mode") == "fuzzy":
                taught += 1
                print(f'    learned "{said}". Things that sound like it will '
                      f"come out right.\n")
            else:
                taught += 1
                print(f'    learned "{said}", but {rec.get("why", "")}.\n')
        print(f"\n  asked about {asked} of {len(rows)}, learned {taught}.")
        return 0

    if cmd == "words":
        from dictator import vocab
        terms = vocab.shared().terms
        if not terms:
            print('nothing learned yet. Teach it with: dictator learn "Whisper Flow"')
            return 0
        for t, rec in sorted(terms.items()):
            heard = ", ".join(rec.get("heard", [])[:3])
            print(f"  {t}"
                  + (f"   ({rec.get('mode')})" if rec.get("mode") else "")
                  + (f"   heard as: {heard}" if heard else ""))
        # Corrections seen once. Shown because a word that is "nearly learned"
        # is the most common thing a user wonders about.
        from dictator import learn
        pending = learn.waiting()
        if pending:
            print("\n  noticed once, learning on the next one:")
            for t, rec in sorted(pending.items()):
                was = ", ".join(rec.get("heard", [])[:2])
                print(f"    {t}" + (f"   heard as: {was}" if was else ""))
        _watching()
        return 0

    if cmd == "unlearn":
        term = " ".join(rest).strip()
        from dictator import vocab
        print(f'forgot "{term}".' if vocab.shared().remove(term)
              else f'"{term}" was not learned.')
        return 0

    if cmd == "history":
        from dictator import history
        import time as _t
        n = int(rest[0]) if rest and rest[0].isdigit() else 20
        rows = history.recent(limit=n)
        if not rows:
            print("nothing recorded yet.")
            return 0
        for r in rows:
            when = _t.strftime("%d %b %H:%M", _t.localtime(r["at"]))
            line = r.get("shown") or r.get("heard") or ""
            print(f"  {when}  {line[:90]}")
            if r.get("kept") and r["kept"] != r.get("shown"):
                print(f"{'':16}  you changed it to: {r['kept'][:80]}")
        return 0

    if cmd == "recap":
        from dictator import recap as _recap
        when = next((a for a in rest if not a.startswith("-")), "today")
        plain = "--plain" in rest or "--no-model" in rest
        # Said before the wait rather than after it. Loading a 2.5GB model
        # takes a few seconds and a command that sits there silently reads as
        # a command that has hung.
        if not plain and _recap.available():
            print("  summarising on this machine, a few seconds...",
                  file=sys.stderr, flush=True)
        print(_recap.report(when, prose=not plain).text, end="")
        return 0

    if cmd == "forget":
        from dictator import history
        import time as _t
        what = " ".join(rest).strip()
        # Deleting everything used to be the only thing this command did, and
        # it did it without asking. Both halves of that were wrong: the usual
        # reason to reach for it is one thing you wish you had not said, and
        # an irreversible delete of everything you have ever dictated should
        # take more than four letters and a Return.
        if not what:
            print("usage:")
            print('  dictator forget "the words"   erase everything containing them')
            print("  dictator forget all           erase the whole history")
            return 2
        if what == "all":
            rows = history.recent(5000)
            if not rows:
                print("nothing recorded, so nothing to erase.")
                return 0
            print(f"This erases all {len(rows)} things you have dictated. "
                  f"It cannot be undone.")
            try:
                if input("type ERASE to confirm: ").strip() != "ERASE":
                    print("left alone.")
                    return 0
            except (EOFError, KeyboardInterrupt):
                print("\nleft alone.")
                return 0
            print(f"erased {history.forget(before=9e18)} recorded utterance(s).")
            return 0
        rows = history.matching(what, 5000)
        if not rows:
            print(f'nothing recorded contains "{what}".')
            return 0
        print(f'{len(rows)} of the things you have dictated contain "{what}":\n')
        for r in rows[:10]:
            when = _t.strftime("%d %b %H:%M", _t.localtime(r["at"]))
            line = r.get("shown") or r.get("heard") or ""
            print(f"  {when}  {line[:80]}")
        if len(rows) > 10:
            print(f"  ... and {len(rows) - 10} more")
        try:
            if input("\nerase them? [y/N] ").strip().lower() not in ("y", "yes"):
                print("left alone.")
                return 0
        except (EOFError, KeyboardInterrupt):
            print("\nleft alone.")
            return 0
        print(f"erased {history.forget(containing=what)}.")
        return 0

    if cmd in ("meeting", "meetings"):
        return meeting(rest)

    if cmd == "format":
        if rest and rest[0] == "in":
            return format_in(rest[1:])
        import json
        from dictator import api as _d
        flags = _d.shaping_flags()
        if not rest:
            for k in _d.DEFAULT_SHAPING:
                print(f"  {k:12} {'on' if flags.get(k) else 'off'}")
            print("\n  change with: dictator format lists on")
            print("  or in one application only: dictator format in Slack lists on")
            return 0
        if rest[0] in ("on", "off"):
            flags["enabled"] = rest[0] == "on"
        elif len(rest) >= 2 and rest[0] in flags and rest[1] in ("on", "off"):
            flags[rest[0]] = rest[1] == "on"
        else:
            print("usage: dictator format [lists|punctuation|sentences] on|off")
            return 2
        _d.FORMAT_FILE.parent.mkdir(parents=True, exist_ok=True)
        _d.FORMAT_FILE.write_text(json.dumps(flags, indent=1))
        for k, v in flags.items():
            print(f"  {k:12} {'on' if v else 'off'}")
        return 0

    if cmd == "snippet":
        return snippet(rest)

    if cmd in ("snippets", "expansions"):
        from dictator import snippets as _sn
        items = _sn.shared().items
        if not items:
            print('nothing yet. Add one with:\n'
                  '  dictator snippet "my work email" "krish@example.com"')
            return 0
        for trigger, rec in sorted(items.items()):
            body = " / ".join(rec.get("text", "").splitlines())
            print(f'  say "{trigger}"')
            print(f"       get {body[:100]}"
                  + ("..." if len(body) > 100 else ""))
            if rec.get("count"):
                print(f"       used {rec['count']} time(s)")
        return 0

    if cmd in ("unsnippet", "forgetsnippet"):
        trigger = " ".join(rest).strip()
        if not trigger:
            print('usage: dictator unsnippet "my work email"')
            return 2
        from dictator import snippets as _sn
        print(f'removed "{trigger}".' if _sn.shared().remove(trigger)
              else f'"{trigger}" was not a snippet. See: dictator snippets')
        return 0

    if cmd in ("find", "search"):
        return find(rest)

    if cmd in ("language", "lang"):
        from dictator import stt
        f = core.STATE_DIR / "lang"
        if rest:
            want = "hinglish" if rest[0].lower().startswith("hing") else "english"
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(want)
        print(f"  language: {stt.language()}")
        if stt.language() == "english":
            print("  English goes to the fast engine. If it drops speech, the\n"
                  "  multilingual one picks it up on its own, so Hinglish still\n"
                  "  works without changing this.")
        else:
            print("  Everything goes to the multilingual engine. Slower, and the\n"
                  "  right choice if most of what you say is Hinglish.")
        return 0

    if cmd in ("permissions", "permission", "perms"):
        return permissions("--reset" in rest, "--explain" in rest)

    if cmd in ("delivery", "paste"):
        from dictator import paste as _p
        if rest and rest[0] in ("type", "clipboard"):
            _p.HOW_FILE.parent.mkdir(parents=True, exist_ok=True)
            _p.HOW_FILE.write_text(rest[0])
        now = _p.how()
        print(f"  delivery: {now}")
        if now == "clipboard":
            print("  One paste, whatever the length. Fast, but it is a paste,")
            print("  and some applications treat a long paste as an attachment.")
            print("  Switch with: dictator delivery type")
        else:
            print("  Typed character by character. Touches no clipboard and")
            print("  produces no paste event, so nothing can turn it into an")
            print("  attachment. Slower: about half a second per 300 characters.")
            print("  Switch back with: dictator delivery clipboard")
        return 0

    if cmd == "gesture":
        from dictator import hotkey as _hk
        f = core.STATE_DIR / "gesture"
        if rest and rest[0] in _hk.TOGGLE_KEYS:
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(rest[0])
            print(f"  hands free gesture: {rest[0]}")
            print("  Restart it: dictator off && dictator on")
        else:
            try:
                now = f.read_text().strip()
            except Exception:
                now = _hk.DEFAULT_TOGGLE
            print(f"  hands free gesture: {now}")
            print("  off means hold the key and talk, nothing else.")
            print("  otherwise: hold the key and DOUBLE TAP it to go hands free,")
            print("  and double tap again to stop. Two taps, because one is not")
            print("  distinguishable from simply pressing that key while talking.")
            print(f"  others: {', '.join(k for k in _hk.TOGGLE_KEYS if k != 'off')}")
        return 0

    if cmd == "capture":
        from dictator import api as _api
        want = rest[0] if rest else "status"
        if want == "on":
            _api.CAPTURE_FLAG.parent.mkdir(parents=True, exist_ok=True)
            _api.CAPTURE_FLAG.touch()
            print("  Keeping every recording now, in " + str(_api.CORPUS))
            print("  Just use it normally. Speak the way you actually speak,")
            print("  because careful reading is not what we need to measure.")
            print("  Stop with: dictator capture off")
        elif want == "off":
            try:
                _api.CAPTURE_FLAG.unlink()
            except Exception:
                pass
            print("  Stopped.")
        n = len(list(_api.CORPUS.glob("*.wav"))) if _api.CORPUS.exists() else 0
        secs = 0.0
        if _api.CORPUS.exists():
            import wave as _w
            for f in _api.CORPUS.glob("*.wav"):
                try:
                    with _w.open(str(f)) as h:
                        secs += h.getnframes() / float(h.getframerate() or 1)
                except Exception:
                    pass
        print(f"  capture: {'on' if _api.capturing() else 'off'}"
              f"   |   {n} recording(s), {secs/60:.1f} minutes")
        return 0

    if cmd == "doctor":
        return doctor()

    print(USAGE)
    return 2


MEETING_USAGE = """dictator meeting: record a meeting, and get notes afterwards.

  dictator meeting start [title]   start recording, now, because you said so
  dictator meeting stop            stop, transcribe it here, write the notes
  dictator meeting list            everything recorded, with its size
  dictator meeting show [id]       the notes for one   (--full for every word)
  dictator meeting forget id|all   delete a recording, and mean it
  dictator meeting permissions     walk macOS through allowing system audio

It records two tracks: the microphone, which is you, and the system audio,
which is everybody else. That is also how each line in the transcript knows
who said it. It does not work out who among "them" was speaking, because that
is a research problem and guessing at it would put words in people's mouths.

Everything happens on this Mac. The audio is not uploaded, the transcript is
not uploaded, and the notes are written by a model running here.

  You are recording other people.

Recording a conversation has consent implications, and in some places legal
ones: several US states, and much of Europe, require everyone to agree. This
tool will never start on its own, never detect a meeting, and never hide that
it is running, so that the decision stays yours and stays visible. macOS shows
its own screen recording indicator in the menu bar for as long as it records.
Tell the room. It costs one sentence.
"""


def meeting(rest) -> int:
    """Everything under `dictator meeting`.

    Deliberately one explicit verb per thing. There is no mode this can be left
    in, nothing that starts it from a calendar and nothing that resumes it
    after a restart, because a recorder somebody forgot they armed is the one
    failure that harms other people rather than the user."""
    import time as _t
    from dictator import meeting as m

    what = rest[0] if rest else ""
    args = rest[1:]

    if what in ("", "status"):
        live = m.running()
        if live:
            mins = live.get("elapsed", 0) / 60.0
            print(f"  RECORDING  {live['id']}"
                  + (f"  ({live['title']})" if live.get("title") else ""))
            print(f"  {mins:.1f} minutes so far   "
                  f"them {live.get('them_seconds', 0)/60:.1f} min, "
                  f"you {live.get('me_seconds', 0)/60:.1f} min")
            print("  Stop and write it up:  dictator meeting stop")
            return 0
        print(MEETING_USAGE)
        return 0

    if what in ("permissions", "permission", "perms"):
        return meeting_permissions()

    if what == "start":
        title = " ".join(a for a in args if not a.startswith("-"))
        print("  Starting. macOS will show a recording indicator in the menu "
              "bar.", flush=True)
        got = m.start(title)
        if got.get("problem"):
            print("\n" + got.get("say", "could not start"))
            return 1
        print(f"\n  Recording: {got['id']}")
        if title:
            print(f"  {title}")
        print("  Everyone in the room is being recorded. Tell them.")
        print("  Stop with: dictator meeting stop")
        return 0

    if what == "stop":
        got = m.stop()
        if got.get("problem"):
            print(got.get("say", ""))
            return 1
        mid = got["id"]
        mins = got.get("seconds", 0) / 60.0
        print(f"  Stopped. {mins:.1f} minutes recorded.")
        n = m.chunks_expected(mid)
        # Said BEFORE the wait, not after it. Transcribing an hour of meeting
        # takes minutes, and a command that sits there silently reads as a
        # command that has hung. The dictation path learned the same thing.
        print(f"  Transcribing here, in {n} piece(s). This is the slow part.",
              flush=True)
        t0 = _t.time()

        def progress(who, done, total, at, pct=0):
            # Whole pieces plus how far into the current one, so the number
            # keeps moving through a piece that takes a minute rather than
            # jumping once and then sitting still.
            share = (done - 1 + pct / 100.0) / max(1, total)
            print(f"\r  {int(100 * share):3d}%  piece {done} of {total}  "
                  f"({'you' if who == 'me' else 'them'}, "
                  f"{int(at) // 60:02d}:{int(at) % 60:02d})   ",
                  end="", file=sys.stderr, flush=True)

        m.transcribe(mid, progress)
        print(f"\r  transcribed in {_t.time() - t0:.0f}s"
              + " " * 30, file=sys.stderr, flush=True)
        from dictator import recap as _recap
        if _recap.available():
            print("  Writing the notes on this machine, a few seconds...",
                  file=sys.stderr, flush=True)
        rec = m.notes(mid)
        print()
        print(m.render(rec), end="")
        return 0

    if what in ("list", "ls"):
        print(m.listing(), end="")
        return 0

    if what == "show":
        wanted = next((a for a in args if not a.startswith("-")), "")
        rows = m.ids()
        mid = wanted if wanted in rows else (rows[0] if rows else "")
        if not mid:
            print("No meetings recorded.  (dictator meeting start)")
            return 1
        rec = m.load(mid)
        print(m.render(rec, transcript="--full" in args), end="")
        return 0

    if what == "forget":
        wanted = next((a for a in args if not a.startswith("-")), "")
        if not wanted:
            print("usage: dictator meeting forget <id>|all")
            return 2
        targets = m.ids() if wanted == "all" else [wanted]
        gone = [mid for mid in targets if m.forget(mid)]
        if not gone:
            print(f'no meeting called "{wanted}".')
            return 1
        print(f"deleted {len(gone)} recording(s), audio and transcript.")
        print("  Overwritten before unlinking, so nothing on the filesystem "
              "reads it back.\n"
              "  An SSD moves blocks around underneath us, so that is as far "
              "as software can honestly go.")
        return 0

    print(MEETING_USAGE)
    return 2


def meeting_permissions() -> int:
    """Walk the user to the Screen Recording toggle, and notice it flip.

    The same shape as `dictator permissions`, and for the same reason: an app
    can ask for this and still not appear in the list, and then there is
    nothing to switch on and no way to make it appear. So this reveals the
    bundle in Finder as well, for the plus button."""
    import time as _t
    from dictator import meeting as m

    app = m.build_app()
    if not app:
        print("Could not build the meeting recorder. It needs Apple's command")
        print("line tools:  xcode-select --install")
        return 1

    print("The app that needs the permission is:\n  " + str(m.APP) + "\n")
    print("It is a SECOND app on purpose. macOS remembers a permission against")
    print("one application, so giving this one its own means the dictation")
    print("app's Accessibility and Microphone grants are never disturbed.\n")
    print("Opening Privacy & Security > Screen Recording (macOS may call it")
    print("Screen & System Audio Recording).")
    print("If Dictator Meeting is in the list, switch it on.")
    print("If it is NOT in the list, use the + button and choose the app from")
    print("the Finder window that just opened.\n")
    print("It records no video. The capture is two pixels wide and its frames")
    print("are never read; system audio simply lives behind this permission.\n")

    subprocess.run(["open", "-R", str(m.APP)], capture_output=True)
    subprocess.run(["open",
                    "x-apple.systempreferences:com.apple.preference.security"
                    "?Privacy_ScreenCapture"], capture_output=True)

    print("Watching. Ctrl-C to stop waiting.\n")
    try:
        for i in range(120):
            if m.granted():
                print("\nGranted. Start a meeting:  dictator meeting start")
                return 0
            if i % 15 == 0 and i:
                print(f"  still not granted after {i}s")
            _t.sleep(1)
    except KeyboardInterrupt:
        print()
    print("\nStill not granted. Two things worth checking:")
    print("  1. The toggle next to Dictator Meeting is on, not just present.")
    print("  2. macOS only applies it to a NEW process, which is why this")
    print("     tests it by running the recorder rather than by asking.")
    return 1


def snippet(rest) -> int:
    """Teach it a phrase and the exact text that phrase stands for.

    Two arguments rather than a prompt, because this is a thing people set up
    once and then forget, and an interactive form would be one more thing to
    learn for a command that is used five times in its life."""
    from dictator import snippets as _sn
    force = "--anyway" in rest or "--force" in rest
    args = [a for a in rest if not a.startswith("--")]
    if len(args) < 2:
        print('usage: dictator snippet "my work email" "krish@example.com"')
        print("\n  The trigger is what you SAY. The second half is what you")
        print("  get, character for character. It needs at least two words,")
        print("  because a one word trigger fires in the middle of sentences.")
        return 2
    trigger, text = args[0], " ".join(args[1:]) if len(args) > 2 else args[1]
    rec = _sn.shared().add(trigger, text, force=force)
    if not rec.get("ok"):
        print(f'not added: {rec.get("why", "")}.')
        # The override is only worth mentioning where it applies. Offering it
        # against a one word trigger would be offering somebody a way to
        # break their own dictation.
        if "already dictated" in rec.get("why", ""):
            print(f'\n  add it anyway with: dictator snippet '
                  f'"{trigger}" "..." --anyway')
        return 1
    print(f'  say "{rec["trigger"]}"')
    print(f'  get {rec["text"]}')
    return 0


def find(rest) -> int:
    """Search everything ever dictated, by any of the three texts we keep."""
    from dictator import mac, search
    days, app, limit, copy = 0.0, "", 20, False
    words = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--days", "-d") and i + 1 < len(rest):
            try:
                days = float(rest[i + 1])
            except ValueError:
                days = 0.0
            i += 2
        elif a in ("--app", "-a") and i + 1 < len(rest):
            app, i = rest[i + 1], i + 2
        elif a in ("--limit", "-n") and i + 1 < len(rest):
            limit, i = int(rest[i + 1]), i + 2
        elif a in ("--copy", "-c"):
            copy, i = True, i + 1
        else:
            words.append(a)
            i += 1
    query = " ".join(words).strip()
    if not query:
        print('usage: dictator find the loop [--app Slack] [--days 7] [--copy]')
        return 2

    hits = search.find(query, days=days, app=app, limit=limit)
    if not hits:
        where = f" in {app}" if app else ""
        when = f" in the last {days:.0f} days" if days else ""
        print(f'nothing you dictated{where}{when} has "{query}" in it.')
        return 1

    if copy:
        # The most recent match, not the closest one. "The thing I said about
        # the loop" is almost always the last thing said about the loop, and a
        # command that copies something has to be predictable about what.
        best = max(hits, key=lambda h: h.at)
        mac._pbcopy(best.text)
        print(f"copied what you said at {search.stamp(best.at)}"
              f"{' in ' + best.app if best.app else ''}:\n")
        print(f"  {best.text}")
        return 0

    for h in hits:
        print(f"  {search.stamp(h.at)}  {h.app or 'unknown':<14}  {h.around()}")
    print(f"\n  {len(hits)} of what you have said."
          " Add --copy to put the most recent one on your clipboard.")
    return 0


def format_in(rest) -> int:
    """The formatting rules for one application, and how to change them.

    `terminal` is a group rather than an application, because nobody wants to
    say the same thing separately about Ghostty, iTerm and Terminal."""
    from dictator import api as _d, profiles
    if not rest:
        all_rules = profiles.rules()
        if not all_rules:
            print("  nothing is set per application; the global rules apply")
            print("  everywhere. Change one with:")
            print("    dictator format in Slack lists on")
            print(f"  groups: {', '.join(profiles.GROUPS)}")
            return 0
        for name in sorted(all_rules):
            on = ", ".join(f"{k} {'on' if v else 'off'}"
                           for k, v in sorted(all_rules[name].items()))
            print(f"  {name:14} {on}")
        return 0

    app = rest[0]
    args = rest[1:]
    if not args:
        flags = _d.shaping_flags(app)
        over = {k: v for _, r in profiles.applying(app) for k, v in r.items()}
        for k in _d.DEFAULT_SHAPING:
            mark = "  (set here)" if k in over else ""
            print(f"  {k:12} {'on' if flags.get(k) else 'off'}{mark}")
        if not over:
            print(f"\n  nothing is set for {app}, so the global rules apply.")
        return 0

    if args[0] in ("default", "clear", "reset"):
        print(f"  {app}: back to the global rules."
              if profiles.clear(app) else f"  nothing was set for {app}.")
        return 0

    if len(args) >= 2 and args[0] in _d.DEFAULT_SHAPING and args[1] in ("on", "off"):
        profiles.set_rule(app, args[0], args[1] == "on")
        flags = _d.shaping_flags(app)
        for k in _d.DEFAULT_SHAPING:
            print(f"  {k:12} {'on' if flags.get(k) else 'off'}")
        return 0

    print("usage: dictator format in APP "
          + "|".join(_d.DEFAULT_SHAPING) + " on|off")
    print("       dictator format in APP default")
    return 2


def doctor() -> int:
    """Check the things that actually break, and say which one it is.

    Every line here is something that has silently failed at least once: a
    missing recorder that made the key look dead, a model that was never
    downloaded, an app whose signature had changed so its permissions were
    quietly revoked, and a second listener from another install that pasted
    everything twice."""
    from dictator import always, signing, stt, tcc
    bad = 0

    def ok(label, good, detail="", note=""):
        """`note` says something true about a check that passed. Used where a
        bare "ok" would be read as more than it means."""
        nonlocal bad
        if not good:
            bad += 1
        print(f"  {'ok ' if good else 'BAD'}  {label}"
              + (f"  {detail}" if detail else "")
              + (f"  ({note})" if good and note else ""))

    def unknown(label, detail=""):
        """Not every question has an answer on every machine, and reporting
        "cannot tell" as "fine" is how a doctor comes to pass the exact state
        it exists to report."""
        print(f"  ??   {label}" + (f"  {detail}" if detail else ""))

    print("dictator doctor\n")

    import shutil
    ok("swiftc (builds the key listener)", bool(shutil.which("swiftc")),
       "" if shutil.which("swiftc") else "run: xcode-select --install")
    # Which recorder, by name. The native one is AVFoundation and needs
    # nothing installed; sox is the fallback and is a Homebrew package the
    # user had to go and get. Saying "records your voice: ok" without saying
    # which one hides the difference that matters when a hold comes back empty.
    which_rec = stt.recorder_in_use()
    ok("records your voice", bool(which_rec),
       {"native": "AVFoundation, nothing to install",
        "sox": "sox (fallback: swiftc could not build the native recorder)",
        "": "neither swiftc nor sox. Run: xcode-select --install"}[which_rec])
    whisper = shutil.which("whisper-cli") or shutil.which("whisper-cpp")
    ok("whisper (turns it into text)", bool(whisper),
       "" if whisper else "run: brew install whisper-cpp")

    # Without this the vocabulary and everything learned from corrections is
    # silently inert, which looks exactly like the feature not existing.
    try:
        import jellyfish            # noqa: F401
        has_phonetics = True
    except Exception:
        has_phonetics = False
    ok("phonetic matching (corrections and learning)", has_phonetics,
       "" if has_phonetics else "run: python3 -m pip install --user jellyfish")

    # English and Hinglish need different models, and the big one arrives in
    # the background after the installer has finished, so report each one and
    # say which half is working rather than one line about "the model".
    print(f"  ..   models in {stt.MODEL_DIR}")
    for name, mb, why, essential in stt.SHIPPED:
        here = (stt.MODEL_DIR / name).exists()
        ok(f"  {why}", here,
           "" if here else
           (f"downloading now ({mb}MB)" if stt.arriving(name)
            else f"missing ({mb}MB); run ./install.sh again"))

    # The delivery helper. Without it nothing arrives anywhere, and the only
    # symptom is that the key appears to do nothing.
    from dictator import paste as _paste
    exe = _paste.helper()
    ok(f"can deliver the words ({_paste.how()})", bool(exe),
       "" if exe else "the paste helper is missing and could not be built")

    app_built = always.APP.exists()
    ok(f"app bundle ({always.APP.name})", app_built,
       "" if app_built else "run: dictator build")

    if app_built:
        req = signing.requirement(always.APP)
        stable = "certificate leaf" in req
        ok("app identity survives a rebuild", stable,
           "" if stable else "ad-hoc signed: macOS will forget its permissions")

    # The one that cost days. A ticked checkbox in System Settings and an
    # untrusted app are the same picture, so "is Accessibility on" is not a
    # question anyone can answer by looking. Ask macOS which SIGNATURE the tick
    # was written for and whether this build satisfies it.
    #
    # There are three answers here, not two, and flattening the third into
    # "fine" is the bug this file already had once: a doctor that passes the
    # state it exists to report is worse than no doctor.
    info = tcc.state("accessibility")
    saw = tcc.waiting()
    how, detail = tcc.verdict(info, saw)
    label = "macOS trusts this build for Accessibility"
    if how == "unknown":
        unknown(label, detail)
    else:
        ok(label, how == "ok", detail)
    if info["state"] == tcc.STALE:
        # Name the signature on both sides. This is the difference the user
        # cannot see and the only evidence that the tick is the wrong tick.
        print(f"       macOS remembers:  {info['held_by']}")
        print(f"       this build is:    {info['wanted']}")

    # What the app itself last saw. This is the only signal that survives on a
    # machine where the databases cannot be read, and it is the exact state
    # issue #2 is about: a listener sitting in a loop, silent, forever.
    if saw.get("trusted") is False:
        import time as _time
        mins = max(0, int((_time.time() - float(saw.get("at") or 0)) / 60))
        ok("the listener is past the permission and running", False,
           f"it has been waiting for Accessibility for {mins} min. "
           "Run: dictator permissions")

    on_path = shutil.which("dictator")
    ok("the dictator command is on your PATH", bool(on_path),
       "" if on_path else "run ./install.sh again, or call it by full path")

    # Two listeners on the same key means every hold is handled twice and
    # every sentence is pasted twice, and the symptom reads as a paste bug.
    import getpass
    r = subprocess.run(["pgrep", "-u", getpass.getuser(), "-f", "dictator-hotkey"],
                       capture_output=True, text=True)
    n = len([x for x in (r.stdout or "").split() if x.strip()])
    # Exactly one. Zero means the key does nothing, which is the complaint
    # this check exists to answer, and `n <= 1` quietly passed it.
    # Which advice depends on whether this machine has ever been set up. On a
    # fresh one the answer is "turn it on", and sending somebody to the
    # permissions pane before they have installed anything is the same wrong
    # instruction that reads like a right one that `permissions` itself was
    # just fixed for.
    if n == 1:
        why = ""
    elif n > 1:
        why = (f"{n} are running, so everything is pasted {n} times. "
               "Run: dictator off && dictator on")
    elif not always.installed():
        why = "it has not been turned on yet. Run: dictator on"
    else:
        why = "none is running, so the key does nothing. Run: dictator permissions"
    ok("exactly one key listener", n == 1, why)

    ok("set to start at login", always.installed(),
       "" if always.installed() else "run: dictator on")
    if always.installed():
        # "running now" read as "dictation works", and sat directly under a
        # line saying no listener was running. Both were true: the app process
        # is up and it is waiting for a permission it has not got. Saying
        # which, here, is cheaper than making someone hold the two lines
        # together and work out that they do not contradict each other.
        up = always.running()
        ok("the app is running", up,
           "" if up else "check: dictator log",
           note=("it is up, but waiting rather than listening"
                 if up and n == 0 else ""))

    # A second hold-to-talk listener pastes everything twice, and the symptom
    # looks like a stutter rather than like two programs.
    other = Path.home() / "Library" / "LaunchAgents" / "com.voicebridge.dictate.plist"
    ok("no other dictation key running", not other.exists(),
       "" if not other.exists() else
       "voicebridge's key is also installed; run: vb always off")

    print()
    print("all good." if not bad else f"{bad} problem(s) above.")
    return 0 if not bad else 1


def permissions(reset: bool = False, explain: bool = False) -> int:
    """Say which way this is broken, then walk the user out of it.

    Every part of this exists because of something that actually goes wrong,
    and the worst of them is the one that looks like nothing: a ticked
    checkbox next to Dictator with an app macOS does not trust behind it. The
    tick is drawn from a TCC row; trust is decided by a code requirement
    stored next to it. Change the app's signature and the row survives with
    the old requirement, so the switch stays on, the app stays untrusted, and
    because a row already exists macOS never prompts again. Nothing the user
    can do in that pane fixes it. The entry has to be removed.

    So the first job here is not to open a pane, it is to work out which of
    "never granted" and "granted to a signature that is no longer ours" this
    is, because they need opposite instructions."""
    import time as _t
    from dictator import always, signing, tcc

    app = always.APP

    # --explain is what the app bundle calls from inside its waiting loop, so
    # it must be fast, must print rather than prompt, and above all must not
    # BUILD anything: a rebuild changes the signature, which is the thing that
    # caused this state in the first place.
    if explain:
        print(tcc.report(app=app))
        w = tcc.waiting()
        if w.get("trusted") is False:
            mins = max(0, int((_t.time() - float(w.get("at") or 0)) / 60))
            print(f"\nThe listener has been waiting {mins} minute(s). It "
                  "picks the permission\nup on its own, so there is nothing "
                  "to restart once you have done the above.")
        return 0 if tcc.state("accessibility", app)["state"] == tcc.GRANTED else 1

    if not app.exists():
        print("The app is not built yet. Building it now.")
        if not always.build_app():
            print("Could not build it. Run: dictator doctor")
            return 1

    # An ad-hoc signed bundle is identified by the hash of its own binary, so
    # macOS treats every rebuild as a different application and a permission
    # granted to it does not stick. Asking somebody to grant a permission that
    # cannot stick is worse than asking nothing, so fix the signature first.
    if "cdhash" in signing.requirement(app):
        print("The app is ad-hoc signed, which means macOS would forget this")
        print("permission again. Rebuilding it with a stable identity first.\n")
        always.build_app()
        if "cdhash" in signing.requirement(app):
            print("Still ad-hoc signed. Run `dictator doctor` and look at the")
            print("signing line; the log at ~/.dictator/log has the reason.")
            return 1
        # A new identity means macOS has never seen this app before, so
        # whatever it remembered about the old one is in the way.
        _forget(tcc.state("accessibility", app), everything=True)
        _restart(always)
        print("Rebuilt and restarted.\n")

    info = tcc.state("accessibility", app)
    print(f"The app asking for permission is:\n  {app}\n")
    print(tcc.report(app=app))
    print()

    if info["state"] == tcc.GRANTED and _has_listener():
        # Nothing to fix. Opening System Settings at somebody whose dictation
        # already works is noise, and noise here teaches people to ignore the
        # one time it matters.
        print("Nothing to do. Hold fn anywhere and talk.")
        return 0

    if info["state"] == tcc.GRANTED and not _has_listener():
        # The grant is genuinely ours and the key still does nothing, which
        # means the listener, not the permission. Restarting is cheap and is
        # the only thing left.
        print("The permission is fine, so this is the listener. Restarting "
              "it.\n")
        _restart(always)
        _t.sleep(3)

    if reset or (info["state"] == tcc.STALE and _asked_to_clear()):
        # The command-line equivalent of selecting the row and pressing the
        # minus button. Only the services that are actually stale: an earlier
        # version cleared Microphone as well, on a guess, which threw away a
        # working grant every time it ran.
        cleared = _forget(info)
        if cleared:
            print(f"Removed what macOS remembered about Dictator for: "
                  f"{', '.join(cleared)}.\n")
        _restart(always)
        print("Restarted, so it can ask again.\n")

    print("Opening Privacy & Security > Accessibility, and showing you the")
    print("app in the Finder in case you need the plus button.\n")
    subprocess.run(["open", "-R", str(app)], capture_output=True)
    subprocess.run(["open",
                    "x-apple.systempreferences:com.apple.preference.security"
                    "?Privacy_Accessibility"], capture_output=True)

    print("Watching. This updates itself the moment it starts working.")
    print("Ctrl-C to stop waiting.\n")
    was = None
    try:
        for _ in range(180):
            running = always.running()
            live = _has_listener()
            now = (running, live)
            if now != was:
                print(f"  service running: {'yes' if running else 'no'}"
                      f"   |   listening for the key: {'yes' if live else 'not yet'}")
                was = now
            if live:
                print("\nGranted. Hold fn anywhere and talk.")
                return 0
            _t.sleep(1)
    except KeyboardInterrupt:
        print()
    after = tcc.state("accessibility", app)
    print("\nStill not listening.")
    print(f"  {tcc.summary(after)}")
    if after["state"] == tcc.STALE:
        print("  The tick you can see is still the old one. Remove the row "
              "with the\n  minus button, or run: dictator permissions --reset")
    else:
        print("  Next: dictator doctor")
    return 1


def _forget(info: dict, everything: bool = False) -> list:
    """Remove the TCC rows macOS is holding for us, and say which.

    This is what the minus button does, and `tccutil reset` is the only way to
    do it without the user's hands. It is deliberately narrow: clearing a
    permission the user has granted and that WORKS is the most expensive thing
    this program can do, so only a service we have positively established is
    stale, denied, or unreadable-and-stuck gets cleared."""
    from dictator import tcc
    names = {"accessibility": "Accessibility",
             "input monitoring": "ListenEvent",
             "microphone": "Microphone"}
    if everything:
        want = list(names.values())
    else:
        want = []
        for service, flag in names.items():
            s = tcc.state(service)["state"] if service != info["service"] \
                else info["state"]
            if s in (tcc.STALE, tcc.DENIED):
                want.append(flag)
        if not want:
            # Unreadable databases, so we cannot prove which one is wrong.
            # Accessibility is the one that traps people and the one the user
            # asked about, so clear that and leave the microphone alone.
            want = ["Accessibility"]
    done = []
    for flag in want:
        r = subprocess.run(["tccutil", "reset", flag, "com.dictator.dictation"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            done.append(flag)
    return done


def _asked_to_clear() -> bool:
    """A stale entry cannot be fixed from the pane, so offer the one fix.

    Asked rather than done, because it removes something the user granted and
    they should see that sentence before it happens. A pipe with no terminal
    on it answers no, so the app bundle calling this in the background never
    clears anything behind somebody's back."""
    if not sys.stdin.isatty():
        return False
    try:
        return input("Remove that stale entry now and let the app ask "
                     "again? [y/N] ").strip().lower().startswith("y")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def _restart(always) -> None:
    cli = str(always.REPO / "bin" / "dictator")
    subprocess.run([cli, "off"], capture_output=True)
    subprocess.run([cli, "on"], capture_output=True)


def _has_listener() -> bool:
    """Is a key listener actually up for THIS user?

    Checked by user, because a second account on the same Mac runs its own
    copy and a plain process search returns whichever it finds first, which
    has already produced one wrong diagnosis."""
    import getpass
    try:
        r = subprocess.run(["pgrep", "-u", getpass.getuser(), "-f",
                            "dictator-hotkey"], capture_output=True, text=True)
        return bool(r.stdout.strip())
    except Exception:
        return False


if __name__ == "__main__":
    sys.exit(main(sys.argv))
