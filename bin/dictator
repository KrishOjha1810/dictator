#!/usr/bin/env python3
"""Dictator: hold a key anywhere on your Mac and speak. The words land where
your cursor is.

There is no per-application integration because there is nothing to integrate
with. It pastes the way you would have typed, so it works in the terminal, in
a browser, in Slack, in a text field that was written before any of this
existed.
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from dictator import core

KEYS = ("fn", "rightcmd", "rightopt", "leftcmd")

USAGE = """dictator: hold a key and talk, anywhere on your Mac.

  dictator on [fn|rightcmd|rightopt|leftcmd]
                      start now, and after every restart
  dictator off        stop, and do not start again
  dictator status     is it set up, and is it running
  dictator doctor     check everything and say what is wrong
  dictator permissions  open the right settings pane and watch for the toggle
  dictator delivery [type|clipboard]   how the words get in
  dictator log        the last thing it did
  dictator errors     failures it noticed
  dictator dictate    run it in the foreground (for debugging)
  dictator build      build the app bundle without starting anything

Teaching it your words:
  dictator learn WORD    fix this word when it mishears it
  dictator words         what it has learned
  dictator unlearn WORD  stop fixing it
  dictator history [n]   what you have said
  dictator forget        erase that history

Language:
  dictator language              which language it expects
  dictator language hinglish     skip the English engine entirely
  dictator language english      the default, with automatic fallback

Formatting:
  dictator format                  what is on
  dictator format lists on|off     spoken lists become real lists
  dictator format punctuation on|off
  dictator format off              paste exactly what was said
"""


def _key_from(args, default="fn"):
    for a in args:
        if a in KEYS:
            return a
    return default


def main(argv) -> int:
    cmd = argv[1] if len(argv) > 1 else "status"
    rest = argv[2:]

    if cmd in ("-h", "--help", "help"):
        print(USAGE)
        return 0

    if cmd == "on":
        from dictator import always
        print(always.on(_key_from(rest)))
        return 0

    if cmd == "off":
        from dictator import always
        print(always.off())
        return 0

    if cmd == "status":
        from dictator import always
        print(always.status())
        return 0

    if cmd == "build":
        from dictator import always
        app = always.build_app()
        print(f"built {app}" if app else
              "could not build the app (needs Xcode command line tools)")
        return 0 if app else 1

    if cmd == "dictate":
        from dictator import dictate
        return dictate.run(_key_from(rest), send="--send" in rest,
                           debug="--quiet" not in rest)

    if cmd == "log":
        p = core.STATE_DIR / "dictate.log"
        if not p.exists():
            print("nothing yet. Turn it on with: dictator on")
            return 0
        n = 40
        for a in rest:
            if a.isdigit():
                n = int(a)
        print("".join(p.read_text().splitlines(keepends=True)[-n:]), end="")
        return 0

    if cmd == "errors":
        rows = core.errors()
        if not rows:
            print("no failures recorded.")
            return 0
        import time as _t
        for r in rows:
            when = _t.strftime("%H:%M:%S", _t.localtime(r.get("at", 0)))
            print(f"{when}  [{r.get('where','?')}] {r.get('msg','')} "
                  f"{r.get('hint','')}".rstrip())
        return 0

    if cmd == "learn":
        term = " ".join(rest).strip()
        if not term:
            print('usage: dictator learn "Whisper Flow"')
            return 2
        from dictator import vocab
        rec = vocab.shared().add(term)
        if rec.get("mode") == "fuzzy":
            print(f'learned "{term}". I will fix things that sound like it.')
        else:
            print(f'learned "{term}", but {rec.get("why","")}.')
        return 0

    if cmd == "words":
        from dictator import vocab
        terms = vocab.shared().terms
        if not terms:
            print('nothing learned yet. Teach it with: dictator learn "Whisper Flow"')
            return 0
        for t, rec in sorted(terms.items()):
            heard = ", ".join(rec.get("heard", [])[:3])
            print(f"  {t}"
                  + (f"   ({rec.get('mode')})" if rec.get("mode") else "")
                  + (f"   heard as: {heard}" if heard else ""))
        # Corrections seen once. Shown because a word that is "nearly learned"
        # is the most common thing a user wonders about.
        from dictator import learn
        pending = learn.waiting()
        if pending:
            print("\n  noticed once, learning on the next one:")
            for t, rec in sorted(pending.items()):
                was = ", ".join(rec.get("heard", [])[:2])
                print(f"    {t}" + (f"   heard as: {was}" if was else ""))
        return 0

    if cmd == "unlearn":
        term = " ".join(rest).strip()
        from dictator import vocab
        print(f'forgot "{term}".' if vocab.shared().remove(term)
              else f'"{term}" was not learned.')
        return 0

    if cmd == "history":
        from dictator import history
        import time as _t
        n = int(rest[0]) if rest and rest[0].isdigit() else 20
        rows = history.recent(limit=n)
        if not rows:
            print("nothing recorded yet.")
            return 0
        for r in rows:
            when = _t.strftime("%d %b %H:%M", _t.localtime(r["at"]))
            line = r.get("shown") or r.get("heard") or ""
            print(f"  {when}  {line[:90]}")
            if r.get("kept") and r["kept"] != r.get("shown"):
                print(f"{'':16}  you changed it to: {r['kept'][:80]}")
        return 0

    if cmd == "forget":
        from dictator import history
        n = history.forget(before=9e18)
        print(f"erased {n} recorded utterance(s).")
        return 0

    if cmd == "format":
        import json
        from dictator import api as _d
        flags = _d.shaping_flags()
        if not rest:
            for k in _d.DEFAULT_SHAPING:
                print(f"  {k:12} {'on' if flags.get(k) else 'off'}")
            print("\n  change with: dictator format lists on")
            return 0
        if rest[0] in ("on", "off"):
            flags["enabled"] = rest[0] == "on"
        elif len(rest) >= 2 and rest[0] in flags and rest[1] in ("on", "off"):
            flags[rest[0]] = rest[1] == "on"
        else:
            print("usage: dictator format [lists|punctuation|sentences] on|off")
            return 2
        _d.FORMAT_FILE.parent.mkdir(parents=True, exist_ok=True)
        _d.FORMAT_FILE.write_text(json.dumps(flags, indent=1))
        for k, v in flags.items():
            print(f"  {k:12} {'on' if v else 'off'}")
        return 0

    if cmd in ("language", "lang"):
        from dictator import stt
        f = core.STATE_DIR / "lang"
        if rest:
            want = "hinglish" if rest[0].lower().startswith("hing") else "english"
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(want)
        print(f"  language: {stt.language()}")
        if stt.language() == "english":
            print("  English goes to the fast engine. If it drops speech, the\n"
                  "  multilingual one picks it up on its own, so Hinglish still\n"
                  "  works without changing this.")
        else:
            print("  Everything goes to the multilingual engine. Slower, and the\n"
                  "  right choice if most of what you say is Hinglish.")
        return 0

    if cmd in ("permissions", "permission", "perms"):
        return permissions("--reset" in rest)

    if cmd in ("delivery", "paste"):
        from dictator import paste as _p
        if rest and rest[0] in ("type", "clipboard"):
            _p.HOW_FILE.parent.mkdir(parents=True, exist_ok=True)
            _p.HOW_FILE.write_text(rest[0])
        now = _p.how()
        print(f"  delivery: {now}")
        if now == "clipboard":
            print("  One paste, whatever the length. Fast, but it is a paste,")
            print("  and some applications treat a long paste as an attachment.")
            print("  Switch with: dictator delivery type")
        else:
            print("  Typed character by character. Touches no clipboard and")
            print("  produces no paste event, so nothing can turn it into an")
            print("  attachment. Slower: about half a second per 300 characters.")
            print("  Switch back with: dictator delivery clipboard")
        return 0

    if cmd == "doctor":
        return doctor()

    print(USAGE)
    return 2


def doctor() -> int:
    """Check the things that actually break, and say which one it is.

    Every line here is something that has silently failed at least once: a
    missing recorder that made the key look dead, a model that was never
    downloaded, an app whose signature had changed so its permissions were
    quietly revoked, and a second listener from another install that pasted
    everything twice."""
    from dictator import always, signing, stt
    bad = 0

    def ok(label, good, detail=""):
        nonlocal bad
        if not good:
            bad += 1
        print(f"  {'ok ' if good else 'BAD'}  {label}" + (f"  {detail}" if detail else ""))

    print("dictator doctor\n")

    import shutil
    ok("swiftc (builds the key listener)", bool(shutil.which("swiftc")),
       "" if shutil.which("swiftc") else "run: xcode-select --install")
    rec = shutil.which("rec") or shutil.which("sox")
    ok("sox (records your voice)", bool(rec),
       "" if rec else "run: brew install sox")
    whisper = shutil.which("whisper-cli") or shutil.which("whisper-cpp")
    ok("whisper (turns it into text)", bool(whisper),
       "" if whisper else "run: brew install whisper-cpp")

    # Without this the vocabulary and everything learned from corrections is
    # silently inert, which looks exactly like the feature not existing.
    try:
        import jellyfish            # noqa: F401
        has_phonetics = True
    except Exception:
        has_phonetics = False
    ok("phonetic matching (corrections and learning)", has_phonetics,
       "" if has_phonetics else "run: python3 -m pip install --user jellyfish")

    # English and Hinglish need different models, and the big one arrives in
    # the background after the installer has finished, so report each one and
    # say which half is working rather than one line about "the model".
    print(f"  ..   models in {stt.MODEL_DIR}")
    for name, mb, why, essential in stt.SHIPPED:
        here = (stt.MODEL_DIR / name).exists()
        ok(f"  {why}", here,
           "" if here else
           (f"downloading now ({mb}MB)" if stt.arriving(name)
            else f"missing ({mb}MB); run ./install.sh again"))

    # The delivery helper. Without it nothing arrives anywhere, and the only
    # symptom is that the key appears to do nothing.
    from dictator import paste as _paste
    exe = _paste.helper()
    ok(f"can deliver the words ({_paste.how()})", bool(exe),
       "" if exe else "the paste helper is missing and could not be built")

    app_built = always.APP.exists()
    ok(f"app bundle ({always.APP.name})", app_built,
       "" if app_built else "run: dictator build")

    if app_built:
        req = signing.requirement(always.APP)
        stable = "certificate leaf" in req
        ok("app identity survives a rebuild", stable,
           "" if stable else "ad-hoc signed: macOS will forget its permissions")

    on_path = shutil.which("dictator")
    ok("the dictator command is on your PATH", bool(on_path),
       "" if on_path else "run ./install.sh again, or call it by full path")

    ok("set to start at login", always.installed(),
       "" if always.installed() else "run: dictator on")
    if always.installed():
        ok("running now", always.running(),
           "" if always.running() else "check: dictator log")

    # A second hold-to-talk listener pastes everything twice, and the symptom
    # looks like a stutter rather than like two programs.
    other = Path.home() / "Library" / "LaunchAgents" / "com.voicebridge.dictate.plist"
    ok("no other dictation key running", not other.exists(),
       "" if not other.exists() else
       "voicebridge's key is also installed; run: vb always off")

    print()
    print("all good." if not bad else f"{bad} problem(s) above.")
    return 0 if not bad else 1


def permissions(reset: bool = False) -> int:
    """Walk the user to the two toggles, and notice the moment they flip.

    Every part of this exists because of something that actually goes wrong.
    The app can ask for Accessibility and still not appear in the list, and
    then there is nothing to switch on and no way to make it appear, so this
    also reveals the bundle in Finder for the plus button. And there is no
    notification when a permission changes, so the only way to know is to look
    again, once a second, which is what turns "now restart it" into nothing at
    all to do."""
    import time as _t
    from dictator import always

    from dictator import signing

    app = always.APP
    if not app.exists():
        print("The app is not built yet. Building it now.")
        if not always.build_app():
            print("Could not build it. Run: dictator doctor")
            return 1

    # An ad-hoc signed bundle is identified by the hash of its own binary, so
    # macOS treats every rebuild as a different application and a permission
    # granted to it does not stick. Asking somebody to grant a permission that
    # cannot stick is worse than asking nothing, so fix the signature first.
    if "cdhash" in signing.requirement(app):
        print("The app is ad-hoc signed, which means macOS would forget this")
        print("permission again. Rebuilding it with a stable identity first.\n")
        always.build_app()
        if "cdhash" in signing.requirement(app):
            print("Still ad-hoc signed. Run `dictator doctor` and look at the")
            print("signing line; the log at ~/.dictator/log has the reason.")
            return 1
        # A new identity means macOS has never seen this app before, so
        # whatever it remembered about the old one is in the way.
        for service in ("Accessibility", "Microphone", "ListenEvent"):
            subprocess.run(["tccutil", "reset", service, "com.dictator.dictation"],
                           capture_output=True)
        subprocess.run([str(always.REPO / "bin" / "dictator"), "off"],
                       capture_output=True)
        subprocess.run([str(always.REPO / "bin" / "dictator"), "on"],
                       capture_output=True)
        print("Rebuilt and restarted.\n")

    if reset:
        # Clears a half-granted state where the box is ticked next to an app
        # macOS no longer recognises. The prompt then fires fresh.
        for service in ("Accessibility", "Microphone", "ListenEvent"):
            subprocess.run(["tccutil", "reset", service, "com.dictator.dictation"],
                           capture_output=True)
        print("Cleared what macOS remembered about Dictator.\n")

    print(f"The app asking for permission is:\n  {app}\n")
    print("Opening Privacy & Security > Accessibility.")
    print("If Dictator is in the list, switch it on.")
    print("If it is NOT in the list, click the + button and choose the app")
    print("from the Finder window that just opened.\n")

    subprocess.run(["open", "-R", str(app)], capture_output=True)
    subprocess.run(["open",
                    "x-apple.systempreferences:com.apple.preference.security"
                    "?Privacy_Accessibility"], capture_output=True)

    print("Watching. This updates itself the moment you flip the toggle.")
    print("Ctrl-C to stop waiting.\n")
    was = None
    try:
        for _ in range(180):
            running = always.running()
            live = _has_listener()
            now = (running, live)
            if now != was:
                print(f"  service running: {'yes' if running else 'no'}"
                      f"   |   listening for the key: {'yes' if live else 'not yet'}")
                was = now
            if live:
                print("\nGranted. Hold fn anywhere and talk.")
                return 0
            _t.sleep(1)
    except KeyboardInterrupt:
        print()
    print("\nStill not listening. Two things worth checking:")
    print("  1. The toggle next to Dictator is actually on, not just present.")
    print("  2. dictator doctor")
    return 1


def _has_listener() -> bool:
    """Is a key listener actually up for THIS user?

    Checked by user, because a second account on the same Mac runs its own
    copy and a plain process search returns whichever it finds first, which
    has already produced one wrong diagnosis."""
    import getpass
    try:
        r = subprocess.run(["pgrep", "-u", getpass.getuser(), "-f",
                            "dictator-hotkey"], capture_output=True, text=True)
        return bool(r.stdout.strip())
    except Exception:
        return False


if __name__ == "__main__":
    sys.exit(main(sys.argv))
