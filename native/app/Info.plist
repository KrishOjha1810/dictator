<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Dictator</string>
  <key>CFBundleDisplayName</key><string>Dictator</string>
  <key>CFBundleIdentifier</key><string>com.dictator.dictation</string>
  <key>CFBundleExecutable</key><string>Dictator</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <!-- No LSUIElement: with a UI this is a regular app with a Dock icon and
       an app menu, so it can be quit and force quit like any other. main.swift
       sets the policy at launch: accessory for a headless repo install, and
       when Show in Dock is off. -->
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <!-- These strings ARE the permission dialog. macOS shows them verbatim, so
       they have to answer "why does this want that" in one sentence. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>To hear what you say while you hold the dictation key.</string>
  <key>NSInputMonitoringUsageDescription</key>
  <string>To notice when you hold the dictation key.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>To type what you said into whichever app you were using.</string>
</dict>
</plist>
