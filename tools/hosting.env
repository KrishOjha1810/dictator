# Where releases are served from, read by tools/appcast.sh, tools/publish_r2.sh
# and the release workflow. Both values are public addresses, not secrets.
#
# DOWNLOAD_BASE  the public URL of the R2 bucket holding Dictator.dmg,
#                appcast.xml and latest.json (e.g. https://pub-xxxx.r2.dev)
# SITE_URL       the website (e.g. https://dictator.pages.dev)
#
# Left empty, releases go to GitHub only, exactly as before.
DOWNLOAD_BASE=
SITE_URL=
