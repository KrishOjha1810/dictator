---
const steps = [
  {
    n: "01",
    title: "Hold the key",
    body: "Right ⌥ Option by default, from any app. A small pill appears, and its bars move with your voice, so you always know the microphone is really open.",
  },
  {
    n: "02",
    title: "Say it the way you would",
    body: "English, Hindi, or both in one sentence. Code names, commands and half-English sentences come out the way you would type them.",
  },
  {
    n: "03",
    title: "Let go",
    body: "The sentence is transcribed on your Mac and pasted where your cursor is. Double-tap the key to keep talking hands free.",
  },
];

const tools = [
  { key: "⌥M", title: "Notetaker", body: "Records a meeting and gives you notes from it. It asks before it records anyone." },
  { key: "⌥S", title: "Scratchpad", body: "A notes window with the cursor ready. Notes are plain Markdown files on your Mac." },
  { key: "“…”", title: "Snippets", body: "Say “my work email” and the address lands. Phrases you say often, typed for you." },
  { key: "find", title: "Search everything you said", body: "Find a sentence by what landed or by what it misheard, filtered by app or by day." },
];
---

<section class="frame" id="how">
  <div class="panel">
    <header class="section-head">
      <span class="eyebrow">How it works</span>
      <h2>Hold. Talk. Let go.</h2>
      <p>No window to switch to and no button to click. The words go where you were already typing.</p>
    </header>

    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <span class="n mono">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="lang">
      <div class="lang-copy">
        <span class="eyebrow">Built for Hinglish</span>
        <h3>Spoken in two languages. Written in one script.</h3>
        <p>
          Most dictation gives you mangled English or Devanagari you can't paste into a terminal. Dictator writes mixed
          Hindi and English in Latin script, the way people actually type it.
        </p>
        <p class="note mono">Hinglish accuracy is still improving with every release.</p>
      </div>
      <div class="lang-demo" aria-label="Example">
        <div class="said">
          <span class="mono">You say</span>
          <p>“yaar ye function thoda slow lag raha hai, can you check the loop”</p>
        </div>
        <div class="arrow" aria-hidden="true">↓</div>
        <div class="typed">
          <span class="mono">Dictator types</span>
          <p>yaar ye function thoda slow lag raha hai, can you check the loop<i class="caret"></i></p>
        </div>
        <div class="langs">
          <span class="chip">English</span>
          <span class="chip">Hindi</span>
          <span class="chip">Hinglish</span>
        </div>
      </div>
    </div>

    <ul class="tools">
      {
        tools.map((t) => (
          <li>
            <span class="key">{t.key}</span>
            <h4>{t.title}</h4>
            <p>{t.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  .n {
    color: var(--mint-600);
    margin-bottom: 36px;
  }

  .steps h3 {
    font-size: clamp(28px, 2.6vw, 38px);
  }

  .steps p {
    color: var(--muted);
  }

  .lang {
    margin-top: clamp(14px, 1.8vw, 24px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--radius-lg);
    background: linear-gradient(170deg, #94c6b2 0%, #7fb3a2 55%, #6aa392 100%);
    color: #fff;
  }

  .lang .eyebrow {
    color: #fff;
  }

  .lang-copy {
    display: grid;
    gap: 20px;
  }

  .lang-copy h3 {
    font-size: clamp(34px, 3.8vw, 56px);
  }

  .lang-copy p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.9);
    max-width: 46ch;
  }

  .lang-copy .note {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
  }

  .lang-demo {
    display: grid;
    gap: 10px;
    padding: 18px;
    border-radius: 22px;
    background: #fff;
    color: #14211d;
    box-shadow: 0 24px 50px -24px rgba(20, 40, 36, 0.5);
  }

  .said,
  .typed {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-radius: 16px;
  }

  .said {
    background: #eef3f1;
  }

  .said p {
    font-style: italic;
    color: #4d5d58;
  }

  .typed {
    background: #14211d;
    color: #eaf2ef;
  }

  .typed p {
    font-family: var(--font-mono);
    font-size: 15px;
  }

  .said .mono,
  .typed .mono {
    font-size: 10px;
    color: #8a9b95;
  }

  .arrow {
    text-align: center;
    color: var(--mint-600);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.15em;
    background: var(--cursor);
    box-shadow: 0 0 8px var(--cursor);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .langs {
    display: flex;
    gap: 6px;
    padding: 4px 2px 0;
  }

  .tools {
    list-style: none;
    margin: clamp(14px, 1.8vw, 24px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
  }

  .tools li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--mint-50);
  }

  .key {
    justify-self: start;
    margin-bottom: 18px;
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--card);
    box-shadow: inset 0 -2px 0 var(--mint-200), 0 1px 2px rgba(20, 33, 29, 0.08);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--mint-700);
  }

  .tools h4 {
    font-size: 22px;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .tools p {
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .steps,
    .lang {
      grid-template-columns: 1fr;
    }

    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>
