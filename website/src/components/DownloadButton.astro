---
// The Mac download button. Before the first release it is the same button,
// greyed out, saying "Coming soon".
import { latest, latestMacHref } from "../lib/latest";

interface Props {
  class?: string;
}

const { class: cls = "btn btn-dark" } = Astro.props;
---

{
  latest ? (
    <a class={cls} href={latestMacHref} data-download>
      <slot />
    </a>
  ) : (
    <span class={cls} aria-disabled="true">
      Coming soon
    </span>
  )
}
