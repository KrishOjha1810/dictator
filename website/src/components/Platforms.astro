---
import { latest, latestMacHref, formatSize, formatDate } from "../lib/latest";

interface Props {
  heading?: string;
  intro?: string;
}

const {
  heading = "Download Dictator",
  intro = "Free. Runs entirely on your Mac. Installed copies update themselves.",
} = Astro.props;

const soon = [
  {
    os: "iOS",
    title: "iPhone & iPad",
    body: "Dictate into any app from the keyboard, with the same on-device models.",
    icon: "phone",
  },
  {
    os: "Windows",
    title: "Windows 11",
    body: "Hold a key and talk, in every Windows app. Same Hinglish engine.",
    icon: "windows",
  },
];
---

<section class="frame" id="download">
  <div class="panel">
    <header class="section-head">
      <span class="eyebrow">Download</span>
      <h2>{heading}</h2>
      <p>{intro}</p>
    </header>

    <div class="platforms">
      <article class="mac">
        <div class="top">
          <span class="os">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.2.8 1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-3.9ZM14 5.4c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.4Z"></path></svg>
            macOS
          </span>
          <span class="chip live"><i></i>Available</span>
        </div>

        <h3>Dictator for Mac</h3>
        <dl class="facts">
          <div><dt class="mono">Version</dt><dd>{latest.version}</dd></div>
          <div><dt class="mono">Released</dt><dd>{formatDate(latest.date)}</dd></div>
          <div><dt class="mono">Size</dt><dd>{formatSize(latest.mac.size)}</dd></div>
          <div><dt class="mono">Needs</dt><dd>macOS {latest.mac.minOS.replace(".0", "")}+, {latest.mac.arch}</dd></div>
        </dl>

        <div class="sha">
          <span class="mono">SHA256</span>
          <code title={latest.mac.sha256}>{latest.mac.sha256}</code>
          <button type="button" class="copy mono" data-copy={latest.mac.sha256}>Copy</button>
        </div>

        <div class="actions">
          <a class="btn btn-dark" href={latestMacHref} data-download>
            Download .dmg
          </a>
          <a class="btn btn-soft" href="/download#install">Install guide</a>
        </div>
      </article>

      {
        soon.map((p) => (
          <article class="soon">
            <div class="top">
              <span class="os">
                {p.icon === "phone" ? (
                  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="6" y="2" width="12" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="1.8" />
                    <path d="M10.5 18.5h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                ) : (
                  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M3 5.5 10.5 4.4v7.1H3V5.5Zm8.5-1.2L21 3v8.5h-9.5V4.3ZM3 12.5h7.5v7.1L3 18.5v-6Zm8.5 0H21V21l-9.5-1.3v-7.2Z" />
                  </svg>
                )}
                {p.os}
              </span>
              <span class="chip">Coming soon</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || "");
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Select it";
      }
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
  });
</script>

<style>
  .platforms {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(14px, 1.8vw, 24px);
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--radius-lg);
  }

  .mac {
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  .soon {
    background: var(--mint-50);
    color: var(--muted);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .os {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .live {
    background: #dff3ea;
    color: #2f7a5f;
  }

  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  h3 {
    font-size: clamp(30px, 3vw, 44px);
    margin-top: 18px;
  }

  .soon h3 {
    color: var(--text);
    opacity: 0.55;
  }

  .soon p {
    flex: 1;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 24px;
    margin: 6px 0 0;
  }

  .facts div {
    display: grid;
    gap: 2px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  dt {
    font-size: 10px;
    color: var(--faint);
  }

  dd {
    margin: 0;
    font-size: 17px;
  }

  .sha {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 10px 10px 14px;
    border-radius: 12px;
    background: var(--mint-50);
  }

  .sha .mono {
    font-size: 10px;
    color: var(--faint);
  }

  .sha code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy {
    border: 0;
    padding: 7px 10px;
    border-radius: 8px;
    background: var(--card);
    color: var(--mint-700) !important;
    font-size: 11px !important;
    cursor: pointer;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .actions .btn {
    min-height: 48px;
    padding: 0 18px;
    font-size: 13px;
  }

  @media (max-width: 1080px) {
    .platforms {
      grid-template-columns: 1fr 1fr;
    }

    .mac {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .platforms {
      grid-template-columns: 1fr;
    }
  }
</style>
