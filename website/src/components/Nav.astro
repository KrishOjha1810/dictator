---
import DownloadButton from "./DownloadButton.astro";

interface Props {
  // On the sky hero the nav is white glass; on a light panel it is ink.
  tone?: "sky" | "panel";
}

const { tone = "sky" } = Astro.props;
const links = [
  { href: "/#how", label: "How it works" },
  { href: "/#features", label: "Features" },
  { href: "/download", label: "Install" },
];
---

<header class:list={["nav", tone]}>
  <a class="brand" href="/" aria-label="Dictator home">
    <img src="/icon.png" alt="" width="34" height="34" />
    <span>Dictator</span>
  </a>
  <nav class="links" aria-label="Main">
    {links.map((l) => <a class="mono" href={l.href}>{l.label}</a>)}
    <DownloadButton class="btn btn-dark cta">Download</DownloadButton>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: relative;
    z-index: 3;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .brand img {
    border-radius: 9px;
  }

  .sky .brand {
    color: #fff;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 14px;
  }

  .sky .links {
    background: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .panel .links {
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  .links a.mono {
    padding: 12px 18px;
    border-radius: 9px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .sky .links a.mono {
    color: rgba(255, 255, 255, 0.92);
  }

  .links a.mono:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .panel .links a.mono:hover {
    background: var(--mint-100);
  }

  .cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 13px;
  }

  @media (max-width: 860px) {
    .links a.mono {
      display: none;
    }
  }
</style>
