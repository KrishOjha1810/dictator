---
// The painted backdrop behind the hero: a dusk sky with peach cloud streaks,
// soft teal hills, still water and a glowing key resting on it. All of it is
// CSS and inline SVG, so it costs no image download and scales to any width.

// Deterministic "random" so the meadow is identical on every build.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const petals = Array.from({ length: 150 }, () => {
  const side = rand() < 0.62 ? "left" : "right";
  const x = side === "left" ? rand() * 34 : 78 + rand() * 22;
  const y = 52 + Math.pow(rand(), 0.7) * 46;
  const hue = rand();
  const color = hue < 0.45 ? "#f6c6cf" : hue < 0.7 ? "#fff3f1" : hue < 0.85 ? "#f4a9b7" : "#ffd9b8";
  const size = 2 + rand() * 4.5;
  return { x, y, color, size, o: 0.55 + rand() * 0.45 };
});
---

<div class="sky" aria-hidden="true">
  <div class="cloud c1"></div>
  <div class="cloud c2"></div>
  <div class="cloud c3"></div>
  <div class="cloud c4"></div>

  <svg class="hills" viewBox="0 0 1600 600" preserveAspectRatio="none">
    <defs>
      <linearGradient id="hill-far" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#8cc4b4" />
        <stop offset="1" stop-color="#5f9f8e" />
      </linearGradient>
      <linearGradient id="hill-near" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#79b7a4" />
        <stop offset="1" stop-color="#4e8c7b" />
      </linearGradient>
      <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a9d3c9" />
        <stop offset="0.5" stop-color="#8dc2b6" />
        <stop offset="1" stop-color="#6aa797" />
      </linearGradient>
    </defs>
    <path d="M0 330 C 180 250 320 300 470 270 C 640 236 760 300 900 280 C 1080 254 1180 170 1330 190 C 1450 205 1520 250 1600 236 L1600 420 L0 420 Z" fill="url(#hill-far)" opacity="0.85" />
    <path d="M0 380 C 220 330 360 360 560 344 C 760 328 900 380 1100 356 C 1280 334 1420 300 1600 318 L1600 430 L0 430 Z" fill="url(#hill-near)" opacity="0.9" />
    <rect x="0" y="408" width="1600" height="192" fill="url(#water)" />
  </svg>

  <div class="ripples"></div>

  <div class="key-scene">
    <div class="glow"></div>
    <div class="key"><span>⌥</span><small>option</small></div>
    <div class="key reflection"><span>⌥</span><small>option</small></div>
  </div>

  <div class="meadow">
    {
      petals.map((p) => (
        <i
          style={`left:${p.x.toFixed(2)}%;top:${p.y.toFixed(2)}%;width:${p.size.toFixed(1)}px;height:${p.size.toFixed(1)}px;background:${p.color};opacity:${p.o.toFixed(2)}`}
        />
      ))
    }
  </div>

  <div class="grain"></div>
  <div class="veil"></div>
</div>

<style>
  .sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      #6f9fb4 0%,
      #93adc0 22%,
      #c9b3b6 40%,
      #e2b8ab 50%,
      #a9c9c0 62%,
      #86bcae 100%
    );
  }

  .cloud {
    position: absolute;
    border-radius: 50%;
    filter: blur(22px);
  }

  .c1 {
    width: 70%;
    height: 22%;
    left: 8%;
    top: 14%;
    transform: rotate(-14deg);
    background: radial-gradient(closest-side, rgba(255, 150, 120, 1), rgba(255, 140, 130, 0) 70%);
    animation: drift 26s ease-in-out infinite alternate;
  }

  .c2 {
    width: 55%;
    height: 14%;
    left: 38%;
    top: 30%;
    transform: rotate(-22deg);
    background: radial-gradient(closest-side, rgba(255, 175, 140, 0.95), rgba(255, 170, 150, 0) 72%);
    animation: drift 32s ease-in-out infinite alternate-reverse;
  }

  .c3 {
    width: 40%;
    height: 10%;
    left: -6%;
    top: 40%;
    transform: rotate(-8deg);
    background: radial-gradient(closest-side, rgba(255, 210, 200, 0.7), rgba(255, 210, 200, 0) 70%);
  }

  .c4 {
    width: 34%;
    height: 9%;
    right: 2%;
    top: 46%;
    transform: rotate(-30deg);
    background: radial-gradient(closest-side, rgba(255, 150, 120, 0.9), rgba(255, 160, 130, 0) 70%);
    animation: drift 22s ease-in-out infinite alternate;
  }

  @keyframes drift {
    to {
      translate: 4% -2%;
    }
  }

  .hills {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 58%;
  }

  .ripples {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 19%;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0 7px,
      rgba(255, 255, 255, 0.16) 7px 8px
    );
    mask-image: linear-gradient(180deg, transparent, #000 40%);
  }

  .key-scene {
    position: absolute;
    left: 50%;
    bottom: 12%;
    width: clamp(90px, 10vw, 150px);
    aspect-ratio: 1;
    translate: -50% 0;
  }

  .glow {
    position: absolute;
    inset: -90%;
    background: radial-gradient(closest-side, rgba(255, 252, 220, 0.85), rgba(255, 240, 200, 0.25) 45%, transparent 70%);
    animation: breathe 5s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      opacity: 0.7;
      scale: 0.94;
    }
  }

  .key {
    position: absolute;
    inset: 0;
    border-radius: 22%;
    background: linear-gradient(160deg, #ffffff 0%, #f2f6f4 55%, #d8e6e1 100%);
    box-shadow:
      inset 0 -8px 0 rgba(120, 160, 150, 0.35),
      inset 0 2px 0 #fff,
      0 0 40px rgba(255, 250, 220, 0.9),
      0 18px 30px -12px rgba(40, 80, 70, 0.5);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2px;
    color: #3e6f62;
  }

  .key span {
    font-size: clamp(30px, 3.4vw, 50px);
    line-height: 1;
  }

  .key small {
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.8vw, 12px);
    letter-spacing: 0.08em;
  }

  .reflection {
    top: 104%;
    bottom: -104%;
    transform: scaleY(-1);
    opacity: 0.22;
    filter: blur(2px);
    mask-image: linear-gradient(0deg, #000, transparent 70%);
  }

  .meadow {
    position: absolute;
    inset: 0;
    filter: blur(0.4px);
  }

  .meadow i {
    position: absolute;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(255, 230, 235, 0.6);
  }

  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* keeps the left column readable over the sky */
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(60, 100, 110, 0.28), transparent 55%),
      linear-gradient(0deg, rgba(60, 110, 98, 0.35), transparent 35%);
  }
</style>
