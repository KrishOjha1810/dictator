---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { releases, macHref, formatDate, formatSize } from "../lib/releases";
---

<Base
  title="Dictator releases"
  description="Every version of Dictator for Mac, with its date, size and SHA256, and a download for each."
>
  <PageHeader
    eyebrow="Releases"
    title="Every version"
    intro="Installed copies update themselves. If you need an older build, every one is here with its checksum."
  />

  <section class="frame">
    <div class="panel">
      <ol class="list">
        {
          releases.map((r, i) => (
            <li id={`v${r.version}`}>
              <div class="ver">
                <h2>{r.version}</h2>
                {i === 0 && <span class="chip latest">Latest</span>}
              </div>
              <dl>
                <div>
                  <dt class="mono">Released</dt>
                  <dd>{formatDate(r.date)}</dd>
                </div>
                <div>
                  <dt class="mono">Size</dt>
                  <dd>{formatSize(r.mac.size)}</dd>
                </div>
                <div>
                  <dt class="mono">Needs</dt>
                  <dd>macOS {r.mac.minOS.replace(".0", "")}+, {r.mac.arch}</dd>
                </div>
                <div class="sha">
                  <dt class="mono">SHA256</dt>
                  <dd>
                    <code>{r.mac.sha256}</code>
                  </dd>
                </div>
              </dl>
              <a class:list={["btn", i === 0 ? "btn-dark" : "btn-soft"]} href={macHref(r.version)} data-download>
                {r.mac.file}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  li {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: clamp(20px, 2.4vw, 30px);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  .ver {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h2 {
    font-size: clamp(36px, 3.4vw, 52px);
  }

  .latest {
    background: #dff3ea;
    color: #2f7a5f;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, auto) minmax(0, 1fr);
    gap: 24px;
  }

  dl div {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  dt {
    font-size: 10px;
    color: var(--faint);
  }

  dd {
    margin: 0;
    white-space: nowrap;
  }

  code {
    display: block;
    padding-right: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1080px) {
    li {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    dl {
      grid-template-columns: repeat(3, auto);
    }

    .sha {
      grid-column: 1 / -1;
    }

    .btn {
      justify-self: start;
    }
  }

  @media (max-width: 560px) {
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
