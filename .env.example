# Copy to .env (never committed) and fill in. A variable set in the
# environment wins over this file. In GitHub Actions the same names are
# repository variables (addresses) and secrets (keys); on Cloudflare Pages
# they are the project's environment variables.

# --- addresses: public, change without touching code ------------------------

# The website. The app checks $DICTATOR_SITE_URL/appcast.xml for updates.
# Unset, the app keeps the feed address it has in native/app/Info.plist.
DICTATOR_SITE_URL=

# The R2 bucket's public URL, serving Dictator.dmg, appcast.xml, latest.json.
# Unset, releases go to GitHub only.
DICTATOR_DOWNLOAD_BASE=

# owner/name of the GitHub repo releases are read from, until the move to R2.
DICTATOR_RELEASES_REPO=

# --- keys: secret ---------------------------------------------------------

# Cloudflare R2 upload key (tools/publish_r2.sh)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: rebuilds the website after a release
CF_PAGES_DEPLOY_HOOK=

# GitHub token for tools/release.sh
GITPAT_TOKEN_MYNK03=

# Release signing (GitHub Actions secrets)
DICTATOR_P12_BASE64=
DICTATOR_P12_PASSWORD=
DICTATOR_SPARKLE_ED_KEY=
