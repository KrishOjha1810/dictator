# Copy to .env (never committed) and fill in. A variable set in the
# environment wins over this file. In GitHub Actions the same names are
# repository variables (addresses) and secrets (keys); on Cloudflare Pages
# they are the project's environment variables.
#
# The standard: .env is this file with the values filled in. Same names, same
# order, each name once, and nothing else; a new variable is added here first.
# tools/check_env.sh checks it, printing names only.

# --- addresses: public, change without touching code ------------------------

# The website. The app checks $DICTATOR_SITE_URL/appcast.xml for updates,
# which redirects into the bucket. Unset, the app checks the bucket directly.
DICTATOR_SITE_URL=

# The R2 bucket's public URL (its custom domain), serving
# Dictator-<VERSION>.dmg, appcast.xml and latest.json. Releases need it.
DICTATOR_DOWNLOAD_BASE=

# --- keys: secret ---------------------------------------------------------

# Cloudflare R2 upload key (tools/publish_r2.sh)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: rebuilds the website after a release
CF_PAGES_DEPLOY_HOOK=

# GitHub token for tools/release.sh: writes the archive release in this
# private repo, so it needs the repo scope
GITPAT_TOKEN_MYNK03=

# Release signing (GitHub Actions secrets)
DICTATOR_P12_BASE64=
DICTATOR_P12_PASSWORD=
DICTATOR_SPARKLE_ED_KEY=
