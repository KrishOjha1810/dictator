<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Dictator</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <!-- The app asks for this so the keyboard does not have to. An extension
       cannot raise the system microphone prompt, so without this the keyboard
       is stuck at "undetermined" with no way out. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Dictator turns what you say into text. The speech model runs on this phone and no audio leaves it.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Dictator transcribes your voice on this phone.</string>
</dict>
</plist>
